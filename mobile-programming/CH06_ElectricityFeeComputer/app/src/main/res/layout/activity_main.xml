<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffe0"
    tools:context=".MainActivity">

    <Spinner
        android:id="@+id/spinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/txv1"
        app:layout_constraintTop_toTopOf="@id/txv1"
        app:layout_constraintBottom_toBottomOf="@+id/txv1"
        android:layout_marginRight="16dp"
        android:entries="@array/v"/>

    <TextView
        android:id="@+id/txv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="伏特(A)："
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"/>

    <TextView
        android:id="@+id/txv2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="安培(A)："
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@+id/spinner"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginLeft="16dp"/>

    <TextView
        android:id="@+id/txv3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="每天使用時數："
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@+id/txv2"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginLeft="16dp"/>

    <TextView
        android:id="@+id/txv4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="每度電費："
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@+id/txv3"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginLeft="16dp"/>

    <EditText
        android:id="@+id/edt1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:inputType="numberDecimal"
        app:layout_constraintBottom_toBottomOf="@+id/txv2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txv2"
        app:layout_constraintStart_toEndOf="@+id/txv2"
        android:layout_marginLeft="0dp"
        android:layout_marginEnd="16dp"/>

    <EditText
        android:id="@+id/edt2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:inputType="numberDecimal"
        app:layout_constraintBottom_toBottomOf="@+id/txv3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txv3"
        app:layout_constraintStart_toEndOf="@+id/txv3"
        android:layout_marginLeft="0dp"
        android:layout_marginEnd="16dp"/>

    <EditText
        android:id="@+id/edt3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:inputType="numberDecimal"
        app:layout_constraintBottom_toBottomOf="@+id/txv4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txv4"
        app:layout_constraintStart_toEndOf="@+id/txv4"
        android:layout_marginLeft="0dp"
        android:layout_marginEnd="16dp"/>

    <TextView
        android:id="@+id/result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="請輸入完整資訊"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txv4"
        android:layout_marginTop="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>