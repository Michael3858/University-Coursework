<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffe0"
    tools:context=".MainActivity2">

    <TextView
        android:id="@+id/showOrder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="妳沒點東西"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="50dp"
        android:layout_marginTop="50dp"/>

    <TextView
        android:id="@+id/showHereOrGo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="50dp"
        android:layout_marginTop="400dp"/>

    <ListView
        android:id="@+id/ForhereOrTogo"
        android:entries="@array/choose"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/showHereOrGo"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="50dp"
        android:layout_marginTop="20dp"/>

    <Button
        android:id="@+id/checkTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CHECK TOTAL"
        android:onClick="checkTotal"
        app:layout_constraintTop_toBottomOf="@id/ForhereOrTogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>